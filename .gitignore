# ── Build outputs ──
/build/
/app/build/
build/

# ── Gradle ──
.gradle/

# ── IDE ──
.idea/
*.iml

# ── Local config (SDK path etc., must not be shared) ──
local.properties

# ── Secrets ──
# 真实密钥只存在本机 .env（由 deploy.py / start.sh 生成），绝不入库。
# .env.example 是模板，必须留着。
.env
*.env
!.env.example
backend/.env
backend/dist/.env

# ── Packaging artifacts ──
aiseclab-backend.zip
/dist/

# ── Release build output ──
/app/release/

# ── Signing material (never commit a keystore) ──
keystore/
*.jks
*.keystore

# ── Python ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── OS junk ──
.DS_Store
Thumbs.db

# ── 调试过程产物（截图 / 日志 / 旧构建目录）──
# 只把固化下来、需要复用的构建脚本纳入版本控制，其余一律不入库。
_shot/*
!_shot/*.py

# ── 模块 B ──
# var/ 是账本等运行时状态（本机所有，不该进版本库）；_test.log 是临时日志。
module-b/var/
module-b/_test.log
