# ── Build outputs ──
/build/
/app/build/
build/

# ── Gradle ──
.gradle/

# ── IDE ──
.idea/
*.iml

# ── Local config (SDK path etc., must not be shared) ──
local.properties

# ── Packaging artifacts ──
aiseclab-backend.zip
/dist/

# ── Release build output ──
/app/release/

# ── Signing material (never commit a keystore) ──
keystore/
*.jks
*.keystore

# ── Python ──
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── OS junk ──
.DS_Store
Thumbs.db

# ── 调试过程产物（截图 / 日志 / 旧构建目录）──
# 只把固化下来、需要复用的构建脚本纳入版本控制，其余一律不入库。
_shot/*
!_shot/*.py
