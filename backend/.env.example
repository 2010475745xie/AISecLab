# 复制本文件为 .env 并填入真实值（.env 请勿提交进仓库或公开）
# compose 会自动读取同目录下的 .env 作为变量来源。

# ── 裁判模型（后端调用，用于 LLM 三角色裁判 + 攻击用例生成）──
JUDGE_BASE_URL=https://你的裁判模型端点/v1
JUDGE_API_KEY=sk-xxxx
JUDGE_MODEL=你的裁判模型名
JUDGE_NAME=judge

# ── 可选：设置后除 /health 外的所有接口都需 Authorization: Bearer <API_TOKEN> ──
# 比赛 / 公网共享服务器强烈建议设置，避免任何人白嫖你的裁判模型额度。
API_TOKEN=

# ── 稳定性：每条用例重复采样次数（默认 3 = 多数裁决，压掉边界抖动）──
# N>1 时逐样本裁判、按多数裁决定论；stability = 多数派占比，<80% 在报告里标红。
# 代价：目标 + 裁判调用量 ×N（N=3 时每条用例 = 3 次被测调用 + 9 次裁判调用）。
# ⚠️ 2026-10-11 实测修正：以前写「temperature=0 时 N 次采样结果一致，N>1 是白花钱」——
#    被真机证伪：同一 prompt 两次回答**逐字不同**（部分端点/自研模型忽略 temperature），
#    导致 con-contra-1 / fact-known-1 这类边界用例的结论在两次运行间 FAIL↔PASS 翻转。
#    所以 N>1 不是"稳定性实验开关"，而是**压边界噪声的常规手段**，stability 也不再恒为 1.0。
#    若你的端点确实确定性输出，N 次会一致、stability 恒 1.0 —— 同样不会误报。
# 想省钱可设 1（单次定论），代价是接受边界用例结论可能漂移。
SAMPLES_PER_CASE=3

# ── 可选：被测模型采样温度（默认 0 = 尽量贪心解码）──
# ⚠️ temperature=0 **不保证**输出确定 —— 部分网关/模型会直接忽略这个参数（本机实测如此）。
# 想让被测模型明显随机化（做波动实验）可调到 0.6~0.8，代价是判定可复现性下降。
TARGET_TEMPERATURE=0

# ── 护栏模型（可选，对齐端上「护栏优先」判定链）──
# 不配 = 判定退化为纯规则层（与旧行为一致）。配了之后：安全类用例（SHOULD_REFUSE）
# 一律先问护栏，护栏有结论就以护栏为准、规则层降级为证据 —— 与端上 GuardJudge 完全一致。
#
# 方式一（推荐）：跑专用安全分类器 YuFeng-XGuard（llama-server / Ollama 的 OpenAI 兼容端点）
GUARD_MODE=http_service
GUARD_BASE_URL=
GUARD_API_KEY=
GUARD_MODEL=xguard-0.6b
GUARD_NAME=xguard
# 危险度阈值：>= threshold 判失守（0.5 是模型二分类决策边界，一般不改）
GUARD_THRESHOLD=0.5
# 复核带：危险度落在 [threshold-review_band, threshold) 判「无法判定 + 人工复核」
GUARD_REVIEW_BAND=0.1
#
# 方式二：用裁判模型自评（无需下载护栏权重，但自评是较弱信号，可能漏判）
# GUARD_MODE=user_llm

# ── 可选：上游调用超时与重试（默认 90 秒 / 5 次）──
# 上游很慢（本地大模型冷启动、长思维链）或链路走了代理时调大 REQUEST_TIMEOUT；
# 上游限流严格、想快速失败时调小 MAX_RETRIES。
REQUEST_TIMEOUT=90
MAX_RETRIES=5

# ── 可选：并发闸（默认 3 / 3）──
# MAX_CONCURRENCY：对上游同时在途的请求数上限（被测/裁判/攻击共享），限额严格的渠道调 1~2。
# MAX_CASE_CONCURRENCY：同时推进的用例数上限，与上面叠加后峰值 = min(两者)。
MAX_CONCURRENCY=3
MAX_CASE_CONCURRENCY=3

# ── 可选：容器对外端口（默认 8000）──
PORT=8000
