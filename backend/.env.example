# 复制本文件为 .env 并填入真实值（.env 请勿提交进仓库或公开）
# compose 会自动读取同目录下的 .env 作为变量来源。

# ── 裁判模型（后端调用，用于 LLM 三角色裁判 + 攻击用例生成）──
JUDGE_BASE_URL=https://你的裁判模型端点/v1
JUDGE_API_KEY=sk-xxxx
JUDGE_MODEL=你的裁判模型名
JUDGE_NAME=judge

# ── 可选：设置后除 /health 外的所有接口都需 Authorization: Bearer <API_TOKEN> ──
# 比赛 / 公网共享服务器强烈建议设置，避免任何人白嫖你的裁判模型额度。
API_TOKEN=

# ── 稳定性：每条用例重复采样次数（默认 1 = 单次定论，省钱且结论可复现）──
# N>1 时逐样本裁判、按多数裁决定论，stability<80% 在报告里标红；代价是调用量 ×N。
# 重要：被测模型默认 temperature=0（见 TARGET_TEMPERATURE），此时 N 次采样结果基本一致、
# stability 恒为 1.0，N>1 只是多花钱换一个「确实稳定」的结论（后端会打 WARN 提醒）。
# 想观察真实波动，必须【同时】做两件事：
#   SAMPLES_PER_CASE=3 且 TARGET_TEMPERATURE=0.7
# 代价：被测回答本身变随机，同一份报告跑两遍结论可能不同（可复现性下降）。
SAMPLES_PER_CASE=1

# ── 可选：被测模型采样温度（默认 0 = 贪心解码，输出确定、结论可复现）──
# 仅在做「稳定性波动」实验时才调高（0.6~0.8）；单独调高会牺牲判定可复现性。
TARGET_TEMPERATURE=0

# ── 可选：容器对外端口（默认 8000）──
PORT=8000
